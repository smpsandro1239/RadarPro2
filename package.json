{
  "name": "radarpro-portugal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "dev:local": "cross-env TURSO_DATABASE_URL=file:./local.db TURSO_AUTH_TOKEN= next dev",
    "dev:live": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "verify": "npm run typecheck && npm run typecheck:scripts && npm run test && npm run build",
    "release:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-token-rotated.ts",
    "check:ids": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-property-ids.ts",
    "db:local": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db-local.ts",
    "db:local:reset": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db-local.ts --reset",
    "db:local:seed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db-local.ts --seed",
    "db:recreate": "npm run db:local:reset && npm run db:local:seed",
    "backfill:origin": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/backfill-data-origin.ts",
    "db:stats": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db-stats.ts",
    "db:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-schema.ts",
    "scrape:dry-run": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/scrape-dry-run.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@sentry/nextjs": "^11.10.0",
    "@sentry/webpack-plugin": "^11.10.0",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "inngest": "^4.26.1",
    "jose": "^6.2.13",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^1.11.0",
    "next": "^16.4.3",
    "node-html-parser": "^9.0.6",
    "playwright": "^1.64.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "resend": "^6.35.0",
    "stripe": "^23.0.1",
    "typesense": "^3.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.4.47",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
